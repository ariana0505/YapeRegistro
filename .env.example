# Solo para desarrollo local. Reemplaza estos valores antes de publicar la aplicación.
DJANGO_SECRET_KEY=replace-with-a-long-random-value-before-deploying
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
POSTGRES_DB=yaperegistro
POSTGRES_USER=yaperegistro
POSTGRES_PASSWORD=local-development-only-change-me
DATABASE_URL=postgresql://yaperegistro:local-development-only-change-me@db:5432/yaperegistro
PORT=8000
